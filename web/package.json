{
  "name": "nearbyfeed-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm --prefix ../packages/shared run build",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm --prefix ../packages/shared run build",
    "build": "tsc -b && vite build",
    "pretest": "npm --prefix ../packages/shared run build",
    "test": "vitest run",
    "type-check": "tsc -b --pretty false"
  },
  "dependencies": {
    "@nearbyfeed/shared": "file:../packages/shared",
    "@tanstack/react-query": "^5.59.16",
    "lucide-react": "^0.468.0",
    "mapbox-gl": "^3.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
