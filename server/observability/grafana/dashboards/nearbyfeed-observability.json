      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nearbyfeed-clickhouse"
          },
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(event_time) AS time, 'avg' AS metric, avg(JSONExtractFloat(properties, 'durationMs')) AS value FROM nearbyfeed_observability.nearbyfeed_events WHERE $__timeFilter(event_time) AND event_name = 'api.request' GROUP BY time UNION ALL SELECT toStartOfMinute(event_time) AS time, 'p95' AS metric, quantile(0.95)(JSONExtractFloat(properties, 'durationMs')) AS value FROM nearbyfeed_observability.nearbyfeed_events WHERE $__timeFilter(event_time) AND event_name = 'api.request' GROUP BY time ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "API latency",
      "type": "timeseries"
    },
