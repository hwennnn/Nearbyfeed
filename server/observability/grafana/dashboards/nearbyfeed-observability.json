        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "nearbyfeed-clickhouse"
          },
          "format": "time_series",
          "rawSql": "SELECT toStartOfMinute(event_time) AS time, concat('HTTP ', toString(JSONExtractInt(properties, 'statusCode'))) AS metric, count() AS value FROM nearbyfeed_observability.nearbyfeed_events WHERE $__timeFilter(event_time) AND event_name = 'api.request' GROUP BY time, metric ORDER BY time",
          "refId": "A"
        }
      ],
      "title": "API requests by status",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "nearbyfeed-clickhouse"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
